<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hockeystick.keeper</string>

  <!-- Runs a single sweep and exits; launchd restarts it on the interval. A
       long-lived loop would silently die and leave series unsettled. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/shaan/Marketplay/contracts/keeper &amp;&amp; set -a &amp;&amp; . ./.env &amp;&amp; set +a &amp;&amp; exec node keeper.mjs --once</string>
  </array>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/shaan/Marketplay/contracts/keeper/keeper.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/shaan/Marketplay/contracts/keeper/keeper.log</string>
</dict>
</plist>
